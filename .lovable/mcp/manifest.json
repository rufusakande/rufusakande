            },
            "title": {
              "type": "string"
            },
            "category": {
              "type": "string"
            },
            "short_description": {
              "type": "string"
            },
            "long_description": {
              "type": "string"
            },
            "project_url": {
              "type": "string",
              "format": "uri"
            },
            "image_url": {
              "type": "string",
              "format": "uri"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "gallery": {
              "type": "array",
              "items": {
                "type": "string",
