  "mcp": {
    "server": {
      "name": "rufus-akande-mcp",
      "version": "0.1.0",
      "title": "Rufus Akande Portfolio MCP"
    },
    "tools": [
      {
        "name": "list_portfolio",
        "title": "List portfolio projects",
        "description": "List portfolio projects. Non-admins only see published projects; admins see all.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "status": {
              "description": "Filter by status. Defaults to published.",
              "type": "string",
              "enum": [
                "published",
                "draft",
                "any"
              ]
            },
            "limit": {
              "description": "Max rows to return (default 50).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_portfolio",
        "title": "Get portfolio project",
        "description": "Fetch a single portfolio project by id, including gallery and videos.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Portfolio project id (UUID)."
            }
          },
          "required": [
            "id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "create_portfolio",
        "title": "Create portfolio project",
        "description": "Create a portfolio project. Requires an admin account (enforced by row-level security).",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "category": {
              "type": "string"
            },
            "short_description": {
              "type": "string"
            },
            "long_description": {
              "type": "string"
            },
            "project_url": {
              "type": "string",
              "format": "uri"
            },
            "image_url": {
              "type": "string",
              "format": "uri"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "gallery": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uri"
              }
            },
            "videos": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uri"
              }
            },
            "status": {
              "type": "string",
              "enum": [
                "draft",
                "published"
              ]
            }
          },
          "required": [
            "title"
          ]
        },
        "outputSchema": null
      },
